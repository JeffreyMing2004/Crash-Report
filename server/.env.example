# AI Provider: openai | deepseek | ollama | custom
AI_PROVIDER=openai

# OpenAI-compatible API Key
OPENAI_API_KEY=sk-your-key-here

# API Base URL (change for different providers)
# OpenAI: https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
# Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Model name
# OpenAI: gpt-4o, gpt-4o-mini
# DeepSeek: deepseek-chat
# Ollama: llama3, qwen2, etc.
AI_MODEL=gpt-4o-mini

# Server port
PORT=3000

# Redis (for session storage)
# Install Redis locally or use a cloud Redis service
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT Secret (change in production!)
JWT_SECRET=change-me-to-a-random-string

# 微信开放平台 (wechat login, leave empty to use dev mode)
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 站点 URL (for share links and wechat callback)
SITE_URL=http://localhost:3000
